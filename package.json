{
  "name": "koenig-room",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "overrides": {
    "tailwindcss": "3.4.17"
  },
  "scripts": {
    "dev": "npm --workspace front run dev",
    "build": "npm --workspace front run build",
    "start": "npm --workspace front run start",
    "lint": "npm --workspace front run lint",
    "bot": "npm --workspace back run bot",
    "trim:carpets:json": "node back/trim-collection.mjs carpet_items 100 --inplace",
    "trim:rugs:public": "node front/scripts/trim-rugs-json.mjs 50 --inplace"
  }
}
